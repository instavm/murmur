#!/usr/bin/env node
// Preflight: validate Node version and ensure node:sqlite is loadable
// before any module statically imports it. Re-exec with --experimental-sqlite
// on Node 22.5–23.x if needed.

const [maj, min] = process.versions.node.split(".").map(Number);
if (maj < 22 || (maj === 22 && min < 5)) {
  console.error(
    `murmur requires Node.js >=22.5 (you have ${process.versions.node}).\n` +
    `Install a newer Node via your version manager, e.g.:\n` +
    `  nvm install --lts && nvm use --lts\n` +
    `  # or: fnm install --lts && fnm use lts-latest\n` +
    `  # or: brew install node@22`,
  );
  process.exit(1);
}

let sqliteOk = false;
try {
  await import("node:sqlite");
  sqliteOk = true;
} catch {}

if (!sqliteOk) {
  const hasFlag = process.execArgv.some((a) => a.startsWith("--experimental-sqlite"));
  if (hasFlag) {
    console.error(
      `node:sqlite unavailable even with --experimental-sqlite on Node ${process.versions.node}.\n` +
      `Please upgrade Node.js to >=22.5.`,
    );
    process.exit(1);
  }
  const { spawnSync } = await import("node:child_process");
  const r = spawnSync(
    process.execPath,
    ["--experimental-sqlite", ...process.argv.slice(1)],
    { stdio: "inherit" },
  );
  process.exit(r.status ?? 1);
}

const { run } = await import("../src/cli/main.mjs");
await run(process.argv.slice(2));
